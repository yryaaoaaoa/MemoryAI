{
  "name": "ai-job-prep-frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.10.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "predev": "npx kill-port@latest 5173 5174 5175",
    "dev": "vite",
    "dev:tree": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "build:tree": "vue-tsc -b && vite build --config vite.tree.config.ts",
    "build": "vue-tsc -b && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.16.1",
    "dompurify": "^3.4.17",
    "element-plus": "^2.14.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "sass-embedded": "^1.99.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
